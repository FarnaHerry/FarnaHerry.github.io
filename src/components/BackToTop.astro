---

<button class="back-to-top" aria-label="回到顶部" title="回到顶部">
  <!-- 无尾上箭头 (Chevron Up) -->
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <polyline points="18 15 12 9 6 15"></polyline>
  </svg>
</button>

<script>
  function setupBackToTop() {
    const btn = document.querySelector<HTMLButtonElement>(".back-to-top");
    if (!btn) return;

    (window as any).__backToTopAC?.abort();
    const ac = new AbortController();
    (window as any).__backToTopAC = ac;
    const { signal } = ac;

    const onScroll = () => {
      if (window.scrollY > 300) {
        btn.classList.add("show");
      } else {
        const wasFocused = document.activeElement === btn;
        btn.classList.remove("show");
        if (wasFocused) {
          document.getElementById("main-content")?.focus({ preventScroll: true });
        }
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true, signal });
    btn.addEventListener(
      "click",
      () => {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
      },
      { signal }
    );
    onScroll();
  }

  setupBackToTop();
  document.addEventListener("astro:after-swap", setupBackToTop);
</script>

<style>
  .back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    box-shadow: var(--shadow);
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    translate: 0 12px;
    scale: 0.9;
    pointer-events: none;
    transition:
      opacity var(--dur-normal) ease,
      visibility var(--dur-normal) ease,
      translate var(--dur-normal) ease,
      scale var(--dur-normal) ease,
      background-color var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      color var(--dur-fast) ease,
      box-shadow var(--dur-normal) ease;
    backdrop-filter: blur(12px);
  }

  .back-to-top.show {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    scale: 1;
    pointer-events: auto;
  }

  .back-to-top:hover {
    color: var(--primary);
    border-color: var(--card-border-hover);
    box-shadow: var(--shadow-hover);
    translate: 0 -3px;
    scale: 1.05;
  }

  .back-to-top:active {
    translate: 0 0;
    scale: 0.95;
  }

  @media (max-width: 640px) {
    .back-to-top {
      bottom: 1.5rem;
      right: 1.25rem;
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
