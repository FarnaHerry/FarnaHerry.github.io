---
import "../styles/global.css";
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_AUTHOR,
  SITE_URL,
  DEFAULT_OG_IMAGE,
} from "../consts";

interface ArticleMeta {
  pubDate?: Date;
  author?: string;
  tags?: string[];
}

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | string;
  keywords?: string[] | string;
  author?: string;
  type?: "website" | "article";
  article?: ArticleMeta;
  noindex?: boolean;
  customGraphNodes?: any[];
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = DEFAULT_OG_IMAGE,
  author = SITE_AUTHOR,
  type = "website",
  article,
  noindex = false,
  customGraphNodes = [],
} = Astro.props;

// 规范化 SITE_URL 必须包含末尾斜杠
const siteBaseUrl = (Astro.site?.href || `${SITE_URL}/`).replace(/\/?$/, "/");

// Canonical 规范链接（去除任何 URL query 污染）
const canonicalURL = new URL(Astro.url.pathname, siteBaseUrl);

// 解析社交媒体分享卡片封面图（支持 string 路径或 ImageMetadata 对象）
const imagePath =
  typeof image === "string"
    ? image
    : (image as ImageMetadata)?.src || DEFAULT_OG_IMAGE;
const imageURL = new URL(imagePath, siteBaseUrl);

// 搜索引擎 JSON-LD 结构化数据 (Schema.org @graph 规范)
const personId = `${siteBaseUrl}#person`;
const websiteId = `${siteBaseUrl}#website`;

const personNode = {
  "@type": "Person",
  "@id": personId,
  name: author,
  url: siteBaseUrl,
  sameAs: ["https://github.com/FarnaHerry"],
  jobTitle: "C++ / 跨平台桌面开发者",
  knowsAbout: [
    "C++23",
    "EUI",
    "HuxerUI",
    "mcpp",
    "跨平台桌面开发",
    "现代 Web 技术",
  ],
};

const websiteNode = {
  "@type": "WebSite",
  "@id": websiteId,
  name: "Farna",
  url: siteBaseUrl,
  description: SITE_DESCRIPTION,
  inLanguage: "zh-CN",
  publisher: { "@id": personId },
};

const isHomePage =
  canonicalURL.pathname === "/" || canonicalURL.pathname === "";

const graphNodes: any[] = [personNode, websiteNode];

if (type === "article" && article?.pubDate) {
  graphNodes.push({
    "@type": "BlogPosting",
    "@id": `${canonicalURL.href}#article`,
    isPartOf: { "@id": websiteId },
    mainEntityOfPage: canonicalURL.href,
    headline: title,
    description: description,
    image: imageURL.href,
    datePublished: article.pubDate.toISOString(),
    inLanguage: "zh-CN",
    author: { "@id": personId },
    publisher: { "@id": personId },
  });
} else if (isHomePage) {
  graphNodes.push({
    "@type": "ProfilePage",
    "@id": `${siteBaseUrl}#webpage`,
    url: siteBaseUrl,
    name: title,
    isPartOf: { "@id": websiteId },
    about: { "@id": personId },
    mainEntity: { "@id": personId },
    inLanguage: "zh-CN",
  });
} else {
  graphNodes.push({
    "@type": "WebPage",
    "@id": `${canonicalURL.href}#webpage`,
    url: canonicalURL.href,
    name: title,
    isPartOf: { "@id": websiteId },
    inLanguage: "zh-CN",
  });
}

if (customGraphNodes && customGraphNodes.length > 0) {
  graphNodes.push(...customGraphNodes);
}

const schemaData = {
  "@context": "https://schema.org",
  "@graph": graphNodes,
};
---

<!-- 基础元数据 -->
<meta charset="UTF-8" />
<meta
  name="viewport"
  content="width=device-width, initial-scale=1, user-scalable=yes"
/>
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="generator" content={Astro.generator} />

<!-- 搜索引擎爬虫指令 -->
<meta
  name="robots"
  content={noindex
    ? "noindex, nofollow"
    : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
/>

<!-- 规范链接 (Canonical URL) -->
<link rel="canonical" href={canonicalURL.href} />

<!-- 首屏 LCP 核心大图预加载 (极大提升 Core Web Vitals LCP 表现) -->
<link
  rel="preload"
  as="image"
  href="/hero-banner-light.jpg"
  fetchpriority="high"
/>

<!-- 图标与主题色彩 (PWA / Mobile Safari / Chrome Android) -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8fafc" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f172a" />
<meta name="format-detection" content="telephone=no" />

<!-- 预拉取深色模式背景图片，保证主题切换动画丝滑无白屏 -->
<link rel="prefetch" href="/hero-banner-dark.jpg" as="image" />
<link rel="prefetch" href="/footer-banner-dark.jpg" as="image" />

<!-- RSS 订阅 (站点地图通过 robots.txt 自动发现) -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", siteBaseUrl).href}
/>

<!-- Open Graph / 社交媒体卡片 (Facebook, Telegram, WeChat) -->
<meta property="og:site_name" content="Farna" />
<meta property="og:locale" content="zh_CN" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:alt" content={title} />

<!-- 文章专属 Open Graph 属性 -->
{type === "article" && article?.pubDate && (
  <meta property="article:published_time" content={article.pubDate.toISOString()} />
)}
{type === "article" && (
  <meta property="article:author" content={article?.author || author} />
)}

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL.href} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL.href} />
<meta name="twitter:image:alt" content={title} />

<!-- 结构化数据 (JSON-LD Schema.org @graph 格式) -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

<!-- 主题快速初始化（防止白屏闪烁） -->
<script is:inline>
  (function () {
    const theme = localStorage.getItem("theme") || "system";
    if (theme === "dark") {
      document.documentElement.setAttribute("data-theme", "dark");
    } else if (theme === "light") {
      document.documentElement.setAttribute("data-theme", "light");
    } else {
      document.documentElement.removeAttribute("data-theme");
    }
  })();
</script>
