---
import type { HTMLAttributes } from "astro/types";
type Props = Omit<HTMLAttributes<"a">, "target" | "rel"> & {
  href: string;
};

const { href, class: className, ...props } = Astro.props;
---

<a href={href} target="_blank" rel="noopener noreferrer" class:list={[className]} {...props}>
  <slot />
</a>
<style>
  a {
    display: inline-flex;
    align-items: center;
    color: var(--primary);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  a:hover {
    color: var(--primary-hover);
    text-decoration: underline;
  }
  a.active {
    font-weight: bolder;
    text-decoration: underline;
  }
</style>
