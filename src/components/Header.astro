---
import GithubIcon from "../assets/github.svg";
import HeaderLink from "./HeaderLink.astro";
import ExternalLink from "./ExternalLink.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;
---

<header class:list={["site-header", { "header-transparent": transparent }]}>
  <div class="header-inner">
    <nav class="site-nav">
      <ul class="nav-links">
        <li>
          <HeaderLink href="/">
            <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor">
              <path
                d="M6.906.664a1.749 1.749 0 0 1 2.187 0l5.25 4.2c.415.332.657.835.657 1.367v7.019A1.75 1.75 0 0 1 13.25 15h-3.5a.75.75 0 0 1-.75-.75V9H7v5.25a.75.75 0 0 1-.75.75h-3.5A1.75 1.75 0 0 1 1 13.25V6.23c0-.531.242-1.034.657-1.366l5.25-4.2Zm1.25 1.171a.25.25 0 0 0-.312 0l-5.25 4.2a.25.25 0 0 0-.094.196v7.019c0 .138.112.25.25.25H5.5V8.25a.75.75 0 0 1 .75-.75h3.5a.75.75 0 0 1 .75.75v5.25h2.75a.25.25 0 0 0 .25-.25V6.23a.25.25 0 0 0-.094-.195Z"
              ></path>
            </svg>
            <span>主页</span>
          </HeaderLink>
        </li>
        <li>
          <HeaderLink href="/projects">
            <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor">
              <path
                d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.6-1.2-1.6 1.2a.25.25 0 0 1-.4-.2Z"
              ></path>
            </svg>
            <span>开源</span>
          </HeaderLink>
        </li>
        <li>
          <HeaderLink href="/blog">
            <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor">
              <path
                d="M0 3.75C0 2.784.784 2 1.75 2h12.5c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0 1 14.25 14H1.75A1.75 1.75 0 0 1 0 12.25Zm1.75-.25a.25.25 0 0 0-.25.25v8.5c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25v-8.5a.25.25 0 0 0-.25-.25ZM3.5 5h9a.75.75 0 0 1 0 1.5h-9a.75.75 0 0 1 0-1.5Zm0 3h9a.75.75 0 0 1 0 1.5h-9a.75.75 0 0 1 0-1.5Zm0 3h5a.75.75 0 0 1 0 1.5h-5a.75.75 0 0 1 0-1.5Z"
              ></path>
            </svg>
            <span>博客</span>
          </HeaderLink>
        </li>
        <li>
          <HeaderLink href="/about">
            <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor">
              <path
                d="M10.561 8.073a6.005 6.005 0 0 1 3.432 5.142.75.75 0 0 1-1.498.07 4.5 4.5 0 0 0-8.99 0 .75.75 0 0 1-1.498-.07 6.004 6.004 0 0 1 3.431-5.142 3.999 3.999 0 1 1 5.123 0ZM10.5 5a2.5 2.5 0 1 0-5 0 2.5 2.5 0 0 0 5 0Z"
              ></path>
            </svg>
            <span>关于</span>
          </HeaderLink>
        </li>
      </ul>
    </nav>
    <div class="header-right">
      <ThemeToggle />
      <ExternalLink
        href="https://github.com/FarnaHerry/FarnaHerry.github.io"
        class="github-link"
        title="GitHub 仓库"
        aria-label="GitHub 仓库"
      >
        <GithubIcon width="16" height="16" />
        <span>GitHub</span>
      </ExternalLink>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: 0.65rem 1.25rem;
    box-shadow: var(--shadow);
    background-color: var(--card-bg);
    border-bottom: 1px solid var(--card-border);
    transition:
      transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      backdrop-filter 0.25s ease,
      -webkit-backdrop-filter 0.25s ease;
    will-change: transform;
  }

  /* 向下滑动隐藏：通过负位移平滑隐藏到视口上方 */
  .site-header.header-hidden {
    transform: translateY(-100%) !important;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    position: relative;
  }

  .site-nav {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .nav-links {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    list-style-type: none;
    gap: 1.85rem;
    margin: 0;
    padding: 0;
  }

  .nav-links li {
    display: flex;
    align-items: center;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .header-right {
    position: absolute;
    right: 0;
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
    height: 32px;
    border-radius: 8px;
    background-color: var(--tag-bg);
    border: 1px solid var(--card-border);
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .github-link:hover {
    color: var(--primary);
    border-color: var(--primary);
  }

  /* 透明导航栏模式（覆盖在 Hero Banner 图片上） */
  .site-header.header-transparent {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background-color: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: none;
  }

  /* 在透明模式未滚动时，导航文字与图标呈高质感白光并具备文字投影，确保在任何壁纸上清晰明亮 */
  .site-header.header-transparent:not(.header-scrolled) .nav-links a {
    color: #ffffff;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
  }

  .site-header.header-transparent:not(.header-scrolled) .nav-links a:hover {
    color: #93c5fd;
  }

  .site-header.header-transparent:not(.header-scrolled) .nav-links a.active {
    color: #ffffff;
    font-weight: 600;
  }

  .site-header.header-transparent:not(.header-scrolled) .github-link {
    background-color: rgba(0, 0, 0, 0.3);
    border-color: rgba(255, 255, 255, 0.25);
    color: #ffffff;
    backdrop-filter: blur(8px);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }

  .site-header.header-transparent:not(.header-scrolled) .github-link:hover {
    background-color: rgba(0, 0, 0, 0.55);
    border-color: rgba(255, 255, 255, 0.45);
    color: #ffffff;
  }

  .site-header.header-transparent:not(.header-scrolled) :global(.theme-trigger-btn) {
    background-color: rgba(0, 0, 0, 0.3);
    border-color: rgba(255, 255, 255, 0.25);
    color: #ffffff;
    backdrop-filter: blur(8px);
  }

  .site-header.header-transparent:not(.header-scrolled) :global(.theme-trigger-btn:hover) {
    background-color: rgba(0, 0, 0, 0.55);
    border-color: rgba(255, 255, 255, 0.45);
    color: #ffffff;
  }

  /* 当滚动超过 Banner 时，平滑转换为吸顶半透明毛玻璃导航 */
  .site-header.header-transparent.header-scrolled {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background-color: var(--card-bg);
    border-bottom: 1px solid var(--card-border);
    box-shadow: var(--shadow);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  @media (max-width: 768px) {
    .site-header {
      padding: 0.6rem 0.75rem;
    }

    .header-inner {
      display: flex;
      justify-content: space-between;
      position: static;
    }

    .site-nav {
      justify-content: flex-start;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .site-nav::-webkit-scrollbar {
      display: none;
    }

    .header-right {
      position: static;
      flex-shrink: 0;
      gap: 0.5rem;
    }

    .nav-links {
      gap: 0.9rem;
      font-size: 0.88rem;
      white-space: nowrap;
    }
  }
</style>

<script>
  function setupHeaderScrollBehavior() {
    const header = document.querySelector<HTMLElement>(".site-header");
    if (!header) return;

    const isTransparentMode = header.classList.contains("header-transparent");
    let lastScrollY = Math.max(0, window.scrollY);
    let isTicking = false;

    const closeThemeDropdown = () => {
      const themeContainer = document.querySelector(".theme-dropdown-container");
      if (themeContainer?.classList.contains("open")) {
        themeContainer.classList.remove("open");
        const trigger = themeContainer.querySelector(".theme-trigger-btn");
        trigger?.setAttribute("aria-expanded", "false");
      }
    };

    const updateHeader = () => {
      const currentScrollY = Math.max(0, window.scrollY);
      const delta = currentScrollY - lastScrollY;
      const heroBanner = isTransparentMode
        ? document.querySelector<HTMLElement>(".hero-banner")
        : null;

      if (isTransparentMode && heroBanner) {
        // Hero Banner 页面：计算 Banner 有效范围（高度扣除导航栏自身高度）
        const headerHeight = header.offsetHeight || 50;
        const bannerRange = Math.max(0, heroBanner.offsetHeight - headerHeight);

        if (currentScrollY <= bannerRange) {
          // 1. 在 Hero Banner 范围内：一直保持透明显示，绝不隐藏
          header.classList.remove("header-hidden");
          header.classList.remove("header-scrolled");
        } else {
          // 2. 超过 Hero Banner 范围
          header.classList.add("header-scrolled");

          if (delta > 4 || (lastScrollY <= bannerRange && delta > 0)) {
            // 向下滑动或刚滑出 Hero Banner 边界：立即隐藏
            header.classList.add("header-hidden");
            closeThemeDropdown();
          } else if (delta < -6) {
            // 向上滑动：显现导航栏（带毛玻璃底色）
            header.classList.remove("header-hidden");
          }
        }
      } else {
        // 普通页面（无 Hero Banner）的滚动隐藏/显现逻辑
        const topThreshold = 60;
        if (currentScrollY <= topThreshold) {
          header.classList.remove("header-hidden");
          if (isTransparentMode) {
            header.classList.remove("header-scrolled");
          }
        } else {
          if (isTransparentMode) {
            header.classList.add("header-scrolled");
          }
          if (delta > 6) {
            header.classList.add("header-hidden");
            closeThemeDropdown();
          } else if (delta < -6) {
            header.classList.remove("header-hidden");
          }
        }
      }

      lastScrollY = currentScrollY;
      isTicking = false;
    };

    const onScroll = () => {
      if (!isTicking) {
        requestAnimationFrame(updateHeader);
        isTicking = true;
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener(
      "resize",
      () => {
        if (!isTicking) {
          requestAnimationFrame(updateHeader);
          isTicking = true;
        }
      },
      { passive: true }
    );
    updateHeader();
  }

  setupHeaderScrollBehavior();
  document.addEventListener("astro:after-swap", setupHeaderScrollBehavior);
</script>
