---
import GithubIcon from "../assets/github.svg";
import HeaderLink from "./HeaderLink.astro";
import ExternalLink from "./ExternalLink.astro";
---

<header class="site-header">
  <nav class="site-nav">
    <ul class="nav-links">
      <li><HeaderLink href="/projects">开源</HeaderLink></li>
      <li><HeaderLink href="/blog">博客</HeaderLink></li>
      <li><HeaderLink href="/about">关于</HeaderLink></li>
      <li class="github-item">
        <ExternalLink
          href="https://github.com/FarnaHerry/FarnaHerry.github.io"
          class="github-link"
        >
          <GithubIcon width="20" height="20" />
          <span>GitHub</span>
        </ExternalLink>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    padding: 0.85rem 0;
    box-shadow: var(--shadow);
    background-color: var(--card-bg);
    border-bottom: 1px solid var(--card-border);
  }

  .site-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 860px;
    max-width: calc(100% - 2rem);
    margin: 0 auto;
  }

  .nav-links {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    list-style-type: none;
    gap: 2.25rem;
    margin: 0;
    padding: 0;
  }

  .nav-links li {
    display: flex;
    align-items: center;
    font-size: 0.98rem;
    font-weight: 500;
  }

  .github-item :global(.github-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .github-item :global(.github-link:hover) {
    color: var(--primary);
  }

  @media (max-width: 720px) {
    .nav-links {
      gap: 1.25rem;
      font-size: 0.92rem;
    }
  }
</style>
