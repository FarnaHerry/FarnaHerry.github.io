---
import GithubIcon from "../assets/github.svg";
import HeaderLink from "./HeaderLink.astro";
import ExternalLink from "./ExternalLink.astro";
---

<header>
  <nav>
    <div class="internal-links">
      <ul>
        <li><HeaderLink href="/">主页</HeaderLink></li>
        <li><HeaderLink href="/projects">开源</HeaderLink></li>
        <li><HeaderLink href="/blog">博客</HeaderLink></li>
        <li><HeaderLink href="/about">关于</HeaderLink></li>
      </ul>
    </div>
    <div class="social-links">
      <ul>
        <li>
          <ExternalLink
            href="https://github.com/FarnaHerry/FarnaHerry.github.io"
          >
            <GithubIcon width="28" height="28" />
          </ExternalLink>
        </li>
      </ul>
    </div>
  </nav>
</header>

<style>
  header {
    padding: 0.85rem 0;
    box-shadow: var(--shadow);
    background-color: var(--card-bg);
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 860px;
    max-width: calc(100% - 2rem);
    margin: 0 auto;
    gap: 1.5em;
  }

  .internal-links {
    padding: 0;
    margin: 0;
  }

  .internal-links ul {
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: row;
    list-style-type: none;
    gap: 1.25rem;
  }

  .social-links ul {
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    list-style-type: none;
  }
</style>
