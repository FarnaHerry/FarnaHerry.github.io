---
import GithubIcon from "../assets/github.svg";
import HeaderLink from "./HeaderLink.astro";
import ExternalLink from "./ExternalLink.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="site-header">
  <div class="header-inner">
    <div class="header-placeholder" aria-hidden="true"></div>
    <nav class="site-nav">
      <ul class="nav-links">
        <li><HeaderLink href="/projects">开源</HeaderLink></li>
        <li><HeaderLink href="/blog">博客</HeaderLink></li>
        <li><HeaderLink href="/about">关于</HeaderLink></li>
        <li class="github-item">
          <ExternalLink
            href="https://github.com/FarnaHerry/FarnaHerry.github.io"
            class="github-link"
          >
            <GithubIcon width="19" height="19" />
            <span>GitHub</span>
          </ExternalLink>
        </li>
      </ul>
    </nav>
    <div class="header-right">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    padding: 0.75rem 0;
    box-shadow: var(--shadow);
    background-color: var(--card-bg);
    border-bottom: 1px solid var(--card-border);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .header-inner {
    display: grid;
    grid-template-columns: 110px 1fr 110px;
    align-items: center;
    width: 860px;
    max-width: calc(100% - 2rem);
    margin: 0 auto;
  }

  .header-placeholder {
    width: 110px;
  }

  .site-nav {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .nav-links {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    list-style-type: none;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }

  .nav-links li {
    display: flex;
    align-items: center;
    font-size: 0.98rem;
    font-weight: 500;
  }

  .github-item :global(.github-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .github-item :global(.github-link:hover) {
    color: var(--primary);
  }

  .header-right {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    width: 110px;
  }

  @media (max-width: 720px) {
    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
    }

    .header-placeholder {
      display: none;
    }

    .site-nav {
      flex: 1;
      justify-content: flex-start;
    }

    .header-right {
      width: auto;
      flex-shrink: 0;
    }

    .nav-links {
      gap: 0.85rem;
      font-size: 0.9rem;
    }
  }
</style>
