---
interface Props {
  lightImageSrc?: string;
  darkImageSrc?: string;
  imageSrc?: string;
  alt?: string;
}

const {
  lightImageSrc,
  darkImageSrc = "/hero-banner-dark.jpg",
  imageSrc = "/hero-banner-light.jpg",
  alt = "Farna 个人主页横幅 - C++23 原生跨平台桌面开发与 mcpp 生态",
} = Astro.props;

const resolvedLightImage = lightImageSrc || imageSrc;
---

<div class="hero-banner-wrapper">
  <div class="hero-banner">
    <!-- 浅色模式专属大图 (LCP 优先渲染) -->
    <img
      src={resolvedLightImage}
      alt={alt}
      width="1920"
      height="640"
      class="banner-image banner-light"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <!-- 深色模式专属大图 -->
    <img
      src={darkImageSrc}
      alt={alt}
      width="1920"
      height="640"
      class="banner-image banner-dark"
      loading="eager"
      decoding="async"
    />
    <!-- 底部渐变遮罩，使图片与页面主体背景无缝平滑衔接 -->
    <div class="banner-gradient-overlay" aria-hidden="true"></div>
  </div>
</div>

<style>
  .hero-banner-wrapper {
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .hero-banner {
    position: relative;
    width: 100%;
    height: 380px;
    overflow: hidden;
  }

  .banner-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    user-select: none;
  }

  /* 默认显示浅色图片 */
  .banner-dark {
    display: none;
  }

  .banner-light {
    display: block;
  }

  /* 显式深色模式（data-theme="dark"） */
  :global(html[data-theme="dark"]) .banner-light {
    display: none;
  }

  :global(html[data-theme="dark"]) .banner-dark {
    display: block;
  }

  /* 跟随系统首选深色模式且未手动设置主题时 */
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) .banner-light {
      display: none;
    }

    :global(html:not([data-theme])) .banner-dark {
      display: block;
    }
  }

  /* 底部渐变光影，保证深色和浅色模式下自然融入页面背景 */
  .banner-gradient-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100px;
    background: linear-gradient(to bottom, transparent 0%, var(--bg) 100%);
    pointer-events: none;
    z-index: 1;
  }

  @media (max-width: 860px) {
    .hero-banner {
      height: 280px;
    }
  }

  @media (max-width: 480px) {
    .hero-banner {
      height: 210px;
    }
  }
</style>
