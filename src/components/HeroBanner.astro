---
interface Props {
  imageSrc?: string;
  alt?: string;
}

const {
  imageSrc = "/hero-banner.jpg",
  alt = "Hero Banner",
} = Astro.props;
---

<div class="hero-banner-wrapper">
  <div class="hero-banner">
    <img
      src={imageSrc}
      alt={alt}
      class="banner-image"
      loading="eager"
      decoding="async"
    />
    <!-- 底部渐变遮罩，使图片与页面主体背景无缝平滑衔接 -->
    <div class="banner-gradient-overlay" aria-hidden="true"></div>
  </div>
</div>

<style>
  .hero-banner-wrapper {
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .hero-banner {
    position: relative;
    width: 100%;
    height: 380px;
    overflow: hidden;
  }

  .banner-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    user-select: none;
  }

  /* 底部渐变光影，保证深色和浅色模式下自然融入页面背景 */
  .banner-gradient-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100px;
    background: linear-gradient(to bottom, transparent 0%, var(--bg) 100%);
    pointer-events: none;
  }

  @media (max-width: 860px) {
    .hero-banner {
      height: 280px;
    }
  }

  @media (max-width: 480px) {
    .hero-banner {
      height: 210px;
    }
  }
</style>
