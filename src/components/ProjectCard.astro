---
import type { CollectionEntry } from "astro:content";
import TechBadge from "./TechBadge.astro";

interface Props {
  project: CollectionEntry<"projects">["data"];
}

const { project } = Astro.props;
const { name, description, repoUrl, demoUrl, techStack, stars, badge } = project;
---

<div class="project-card">
  <div class="card-header">
    <div class="title-row">
      <svg class="repo-icon" viewBox="0 0 16 16" width="18" height="18" fill="currentColor">
        <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.6-1.2-1.6 1.2a.25.25 0 0 1-.4-.2Z"></path>
      </svg>
      <h3 class="project-name">
        <a href={repoUrl} target="_blank" rel="noopener noreferrer">{name}</a>
      </h3>
    </div>
    <div class="meta-row">
      {badge && <span class="badge-tag">{badge}</span>}
      {stars !== undefined && stars > 0 && (
        <span class="stars-tag" title={`${stars} GitHub stars`}>
          <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor">
            <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"></path>
          </svg>
          <span>{stars}</span>
        </span>
      )}
    </div>
  </div>

  <p class="description">{description}</p>

  <div class="card-footer">
    <div class="tech-stack">
      {techStack.map((tech) => (
        <TechBadge tag={tech} />
      ))}
    </div>
    <div class="action-links">
      {demoUrl && (
        <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="link-btn secondary">
          在线演示
        </a>
      )}
      <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="link-btn primary">
        <span>代码</span>
        <svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor">
          <path fill-rule="evenodd" d="M10.604 1h4.146a.25.25 0 0 1 .25.25v4.146a.25.25 0 0 1-.427.177L13.03 4.03 9.28 7.78a.75.75 0 0 1-1.06-1.06l3.75-3.75-1.543-1.543A.25.25 0 0 1 10.604 1Z M3.75 2A1.75 1.75 0 0 0 2 3.75v8.5c0 .966.784 1.75 1.75 1.75h8.5A1.75 1.75 0 0 0 14 12.25v-3.5a.75.75 0 0 0-1.5 0v3.5a.25.25 0 0 1-.25.25h-8.5a.25.25 0 0 1-.25-.25v-8.5a.25.25 0 0 1 .25-.25h3.5a.75.75 0 0 0 0-1.5h-3.5Z"></path>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    height: 100%;
  }

  .project-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
    border-color: var(--card-border-hover);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .repo-icon {
    color: var(--primary);
    flex-shrink: 0;
  }

  .project-name {
    margin: 0;
    font-size: 1.18rem;
    font-weight: 600;
  }

  .project-name a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .project-name a:hover {
    color: var(--primary);
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .badge-tag {
    font-size: 0.72rem;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    background-color: rgba(0, 102, 204, 0.08);
    color: var(--primary);
    font-weight: 500;
    border: 1px solid rgba(0, 102, 204, 0.2);
  }

  .stars-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .stars-tag svg {
    color: #e3a934;
  }

  .description {
    margin: 0 0 1.25rem 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-muted);
    flex-grow: 1;
  }

  .card-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(128, 128, 128, 0.1);
    margin-top: auto;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }

  .action-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .link-btn.primary {
    background-color: var(--tag-bg);
    color: var(--text);
    border: 1px solid var(--card-border);
  }

  .link-btn.primary:hover {
    background-color: var(--primary);
    color: #ffffff;
    border-color: var(--primary);
  }

  .link-btn.secondary {
    color: var(--primary);
    background-color: transparent;
  }

  .link-btn.secondary:hover {
    text-decoration: underline;
  }
</style>
