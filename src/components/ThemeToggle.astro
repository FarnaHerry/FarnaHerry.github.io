---
---

<div class="theme-dropdown-container" data-current="system">
  <button
    type="button"
    class="theme-trigger-btn"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label="切换主题模式"
    title="切换主题模式"
  >
    <span class="icon-slot icon-system" title="跟随系统">
      <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
        <path
          d="M1.75 1.5a.25.25 0 0 0-.25.25v8.5c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25v-8.5a.25.25 0 0 0-.25-.25ZM0 1.75C0 .784.784 0 1.75 0h12.5C15.216 0 16 .784 16 1.75v8.5A1.75 1.75 0 0 1 14.25 12H9v1.25l1.625.542a.75.75 0 0 1 .5.708v.25a.75.75 0 0 1-.75.75h-4.75a.75.75 0 0 1-.75-.75v-.25a.75.75 0 0 1 .5-.708L7 13.25V12H1.75A1.75 1.75 0 0 1 0 10.25Z"
        ></path>
      </svg>
    </span>
    <span class="icon-slot icon-light" title="浅色模式">
      <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
        <path
          d="M8 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm0 1.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9ZM8 0a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0V.75A.75.75 0 0 1 8 0ZM8 13a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 8 13ZM2.343 2.343a.75.75 0 0 1 1.061 0l1.06 1.061a.75.75 0 0 1-1.06 1.06l-1.06-1.06a.75.75 0 0 1 0-1.061ZM11.536 11.536a.75.75 0 0 1 1.06 0l1.061 1.06a.75.75 0 0 1-1.06 1.061l-1.061-1.06a.75.75 0 0 1 0-1.061ZM0 8a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 0 1.5H.75A.75.75 0 0 1 0 8Zm13 0a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 0 1.5h-1.5A.75.75 0 0 1 13 8ZM2.343 13.657a.75.75 0 0 1 0-1.06l1.06-1.061a.75.75 0 1 1 1.062 1.06l-1.061 1.061a.75.75 0 0 1-1.061 0Zm9.193-9.193a.75.75 0 0 1 0-1.06l1.06-1.061a.75.75 0 1 1 1.061 1.06l-1.06 1.061a.75.75 0 0 1-1.061 0Z"
        ></path>
      </svg>
    </span>
    <span class="icon-slot icon-dark" title="深色模式">
      <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
        <path
          d="M9.598 1.591a.749.749 0 0 1 .785-.175 7.001 7.001 0 1 1-8.967 8.967.75.75 0 0 1 .961-.96 5.5 5.5 0 0 0 7.046-7.046.75.75 0 0 1 .175-.786Zm1.616 1.945a7 7 0 0 1-7.678 7.678A5.499 5.499 0 1 0 11.214 3.536Z"
        ></path>
      </svg>
    </span>
    <svg class="chevron-icon" viewBox="0 0 16 16" width="9" height="9" fill="currentColor">
      <path
        fill-rule="evenodd"
        d="M3.72 6.22a.75.75 0 0 1 1.06 0L8 9.44l3.22-3.22a.75.75 0 1 1 1.06 1.06l-3.75 3.75a.75.75 0 0 1-1.06 0L3.72 7.28a.75.75 0 0 1 0-1.06Z"
      ></path>
    </svg>
  </button>

  <div class="theme-dropdown-menu" role="menu">
    <button
      type="button"
      class="dropdown-item"
      data-theme-val="system"
      role="menuitem"
    >
      <span class="item-icon">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
          <path
            d="M1.75 1.5a.25.25 0 0 0-.25.25v8.5c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25v-8.5a.25.25 0 0 0-.25-.25ZM0 1.75C0 .784.784 0 1.75 0h12.5C15.216 0 16 .784 16 1.75v8.5A1.75 1.75 0 0 1 14.25 12H9v1.25l1.625.542a.75.75 0 0 1 .5.708v.25a.75.75 0 0 1-.75.75h-4.75a.75.75 0 0 1-.75-.75v-.25a.75.75 0 0 1 .5-.708L7 13.25V12H1.75A1.75 1.75 0 0 1 0 10.25Z"
          ></path>
        </svg>
      </span>
      <span>跟随系统</span>
    </button>
    <button
      type="button"
      class="dropdown-item"
      data-theme-val="light"
      role="menuitem"
    >
      <span class="item-icon">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
          <path
            d="M8 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm0 1.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9ZM8 0a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0V.75A.75.75 0 0 1 8 0ZM8 13a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 8 13ZM2.343 2.343a.75.75 0 0 1 1.061 0l1.06 1.061a.75.75 0 0 1-1.06 1.06l-1.06-1.06a.75.75 0 0 1 0-1.061ZM11.536 11.536a.75.75 0 0 1 1.06 0l1.061 1.06a.75.75 0 0 1-1.06 1.061l-1.061-1.06a.75.75 0 0 1 0-1.061ZM0 8a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 0 1.5H.75A.75.75 0 0 1 0 8Zm13 0a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 0 1.5h-1.5A.75.75 0 0 1 13 8ZM2.343 13.657a.75.75 0 0 1 0-1.06l1.06-1.061a.75.75 0 1 1 1.062 1.06l-1.061 1.061a.75.75 0 0 1-1.061 0Zm9.193-9.193a.75.75 0 0 1 0-1.06l1.06-1.061a.75.75 0 1 1 1.061 1.06l-1.06 1.061a.75.75 0 0 1-1.061 0Z"
          ></path>
        </svg>
      </span>
      <span>浅色模式</span>
    </button>
    <button
      type="button"
      class="dropdown-item"
      data-theme-val="dark"
      role="menuitem"
    >
      <span class="item-icon">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
          <path
            d="M9.598 1.591a.749.749 0 0 1 .785-.175 7.001 7.001 0 1 1-8.967 8.967.75.75 0 0 1 .961-.96 5.5 5.5 0 0 0 7.046-7.046.75.75 0 0 1 .175-.786Zm1.616 1.945a7 7 0 0 1-7.678 7.678A5.499 5.499 0 1 0 11.214 3.536Z"
          ></path>
        </svg>
      </span>
      <span>深色模式</span>
    </button>
</div>

<script is:inline>
  (function () {
    try {
      const theme = localStorage.getItem("theme") || "system";
      document.querySelectorAll(".theme-dropdown-container").forEach(function (c) {
        c.setAttribute("data-current", theme);
      });
    } catch (e) {}
  })();
</script>

<script>
  function initThemeDropdown() {
    const container = document.querySelector<HTMLElement>(".theme-dropdown-container");
    if (!container) return;

    const triggerBtn = container.querySelector<HTMLButtonElement>(".theme-trigger-btn");
    const menu = container.querySelector<HTMLElement>(".theme-dropdown-menu");
    const items = container.querySelectorAll<HTMLButtonElement>(".dropdown-item");

    const currentTheme = localStorage.getItem("theme") || "system";

    function updateThemeUI(theme: string) {
      container?.setAttribute("data-current", theme);
      items.forEach((item) => {
        if (item.getAttribute("data-theme-val") === theme) {
          item.classList.add("active");
        } else {
          item.classList.remove("active");
        }
      });
    }

    function isDarkEffective(): boolean {
      const attr = document.documentElement.getAttribute("data-theme");
      if (attr === "dark") return true;
      if (attr === "light") return false;
      return window.matchMedia("(prefers-color-scheme: dark)").matches;
    }

    function willBeDark(theme: string): boolean {
      if (theme === "dark") return true;
      if (theme === "light") return false;
      return window.matchMedia("(prefers-color-scheme: dark)").matches;
    }

    function applyThemeRaw(theme: string) {
      if (theme === "dark") {
        document.documentElement.setAttribute("data-theme", "dark");
      } else if (theme === "light") {
        document.documentElement.setAttribute("data-theme", "light");
      } else {
        document.documentElement.removeAttribute("data-theme");
      }
      localStorage.setItem("theme", theme);
      updateThemeUI(theme);
    }

    function switchTheme(targetTheme: string) {
      const currentDark = isDarkEffective();
      const nextDark = willBeDark(targetTheme);

      // 视觉明暗未发生改变，直接应用并返回
      if (currentDark === nextDark) {
        applyThemeRaw(targetTheme);
        return;
      }

      const isReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      // 降级检查：不支持 View Transitions API 或开启减少动画
      if (!("startViewTransition" in document) || isReducedMotion) {
        applyThemeRaw(targetTheme);
        return;
      }

      // 获取右上角切换按钮的中心坐标作为圆心
      const rect = triggerBtn?.getBoundingClientRect() || {
        left: window.innerWidth - 40,
        top: 20,
        width: 32,
        height: 32,
      };
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const endRadius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y)
      );

      const html = document.documentElement;

      if (nextDark) {
        // 放开（Expand）：浅色 -> 深色，深色视图以圆形由内向外扩散铺满
        html.classList.add("theme-transition-expand");
        html.classList.remove("theme-transition-shrink");

        const transition = (document as any).startViewTransition(() => {
          applyThemeRaw(targetTheme);
        });

        transition.ready.then(() => {
          const animation = html.animate(
            {
              clipPath: [
                `circle(0px at ${x}px ${y}px)`,
                `circle(${endRadius}px at ${x}px ${y}px)`,
              ],
            },
            {
              duration: 480,
              easing: "cubic-bezier(0.4, 0, 0.2, 1)",
              pseudoElement: "::view-transition-new(root)",
            }
          );
          animation.finished.finally(() => {
            html.classList.remove("theme-transition-expand");
          });
        });
      } else {
        // 回收（Shrink）：深色 -> 浅色，深色视图自全屏四周向开关中心收拢收回，露出浅色
        html.classList.add("theme-transition-shrink");
        html.classList.remove("theme-transition-expand");

        const transition = (document as any).startViewTransition(() => {
          applyThemeRaw(targetTheme);
        });

        transition.ready.then(() => {
          const animation = html.animate(
            {
              clipPath: [
                `circle(${endRadius}px at ${x}px ${y}px)`,
                `circle(0px at ${x}px ${y}px)`,
              ],
            },
            {
              duration: 480,
              easing: "cubic-bezier(0.4, 0, 0.2, 1)",
              pseudoElement: "::view-transition-old(root)",
            }
          );
          animation.finished.finally(() => {
            html.classList.remove("theme-transition-shrink");
          });
        });
      }
    }

    function closeMenu() {
      container?.classList.remove("open");
      triggerBtn?.setAttribute("aria-expanded", "false");
    }

    function toggleMenu() {
      const isOpen = container?.classList.toggle("open");
      triggerBtn?.setAttribute("aria-expanded", isOpen ? "true" : "false");
    }

    // 点击切换下拉显隐
    triggerBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    // 点击选项切换主题并关闭下拉
    items.forEach((item) => {
      item.addEventListener("click", (e) => {
        e.stopPropagation();
        const selected = item.getAttribute("data-theme-val") || "system";
        closeMenu();
        switchTheme(selected);
      });
    });

    // 点击外部区域关闭下拉
    document.addEventListener("click", (e) => {
      if (!container.contains(e.target as Node)) {
        closeMenu();
      }
    });

    // ESC 键关闭
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeMenu();
      }
    });

    updateThemeUI(currentTheme);
  }

  initThemeDropdown();
  document.addEventListener("astro:after-swap", initThemeDropdown);
</script>

<style>
  .theme-dropdown-container {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .theme-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.55rem;
    background-color: var(--tag-bg);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    cursor: pointer;
    color: var(--text);
    transition: all 0.15s ease;
    height: 32px;
  }

  .theme-trigger-btn:hover {
    color: var(--primary);
    border-color: var(--primary);
  }

  .icon-slot {
    display: none;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .theme-dropdown-container[data-current="system"] .icon-system {
    display: inline-flex;
  }

  .theme-dropdown-container[data-current="light"] .icon-light {
    display: inline-flex;
  }

  .theme-dropdown-container[data-current="dark"] .icon-dark {
    display: inline-flex;
  }

  .chevron-icon {
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }

  .theme-dropdown-container.open .chevron-icon {
    transform: rotate(180deg);
  }

  .theme-dropdown-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    background-color: var(--header-bg);
    border: 1px solid var(--header-border);
    box-shadow: var(--shadow-hover);
    border-radius: 10px;
    padding: 0.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 125px;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease;
  }

  .theme-dropdown-container.open .theme-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.45rem 0.65rem;
    border: none;
    background: transparent;
    border-radius: 6px;
    cursor: pointer;
    color: var(--text);
    font-size: 0.85rem;
    text-align: left;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .dropdown-item:hover {
    background-color: var(--tag-bg);
    color: var(--primary);
  }

  .dropdown-item.active {
    background-color: var(--tag-bg);
    color: var(--primary);
    font-weight: 600;
  }

  .item-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
</style>
