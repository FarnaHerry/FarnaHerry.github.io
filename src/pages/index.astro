---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BlogCard from "../components/BlogCard.astro";
import HeroBanner from "../components/HeroBanner.astro";

import GithubIcon from "../assets/github.svg";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
// 首页专属结构化数据：将重点开源项目作为 SoftwareSourceCode 实体注入 @graph
const projectSchemaNodes = projects.map((p) => ({
  "@type": "SoftwareSourceCode",
  "@id": `${p.data.repoUrl}#software`,
  name: p.data.name,
  description: p.data.description,
  codeRepository: p.data.repoUrl,
  programmingLanguage: "C++23",
  author: { "@id": "https://farnaherry.github.io/#person" },
}));
---

<BaseLayout
  title="Farna - 个人主页与开源项目"
  description="Farna 的个人博客与开源软件主页，专注于 C++23、mcpp、EUI 与 HuxerUI 原生跨平台桌面开发。"
  transparentHeader={true}
  customGraphNodes={projectSchemaNodes}
>
  <!-- 覆盖顶部的全宽 Hero Banner 图片 -->
  <HeroBanner />

  <div class="home-container">
    <!-- 个人介绍区域 -->
    <section class="profile-section">
      <h1 class="profile-title">
        你好，我是 <span class="gradient-name">Farna</span> <span class="wave-emoji">👋</span>
      </h1>
      <p class="profile-bio">
        专注于现代化 <strong>C++23</strong>、<strong>EUI</strong> 与 <strong>HuxerUI</strong> 原生跨平台桌面应用架构开发，同时致力于构建 <strong>mcpp</strong> 现代 C++ 模块与包管理工具链生态。
      </p>
      <p class="profile-bio profile-bio-sub">
        热衷于探索极致性能、现代原生 GUI 美学与现代 Web 技术的融合创新。在这里，我持续记录开源项目（如 <strong>tinynext</strong> 极简下载器、<strong>llm-switch</strong> AI 助手调度器、<strong>apitab</strong> 接口调试工具、<strong>Clash-Flux</strong> 规则编排端）的架构思考与工程实战。
      </p>
      <div class="profile-actions">
        <a href="/projects" class="btn btn-primary">浏览开源项目 &rarr;</a>
        <a href="/blog" class="btn btn-secondary">阅读技术文章</a>
        <a
          href="https://github.com/FarnaHerry"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-github"
        >
          <GithubIcon width="16" height="16" />
          <span>GitHub</span>
        </a>
      </div>
    </section>

    <!-- 核心板块：开源软件与博客经验 对半开展示 -->
    <div class="showcase-sections">
      <!-- 模块 1：开源项目 -->
      <section class="content-section">
        <div class="section-header">
          <div class="section-title-wrap">
            <span class="section-indicator"></span>
            <h2>开源项目</h2>
          </div>
          <a href="/projects" class="section-more">全部项目 &rarr;</a>
        </div>
        <p class="section-desc">专注于高性能、原生体验的桌面工具与代理生态实践。</p>

        <div class="projects-list">
          {projects.map((project) => (
            <ProjectCard project={project.data} />
          ))}
        </div>
      </section>

      <!-- 模块 2：最新博客与经验 -->
      <section class="content-section">
        <div class="section-header">
          <div class="section-title-wrap">
            <span class="section-indicator post-indicator"></span>
            <h2>经验记录</h2>
          </div>
          <a href="/blog" class="section-more">全部文章 &rarr;</a>
        </div>
        <p class="section-desc">日常技术探索、框架踩坑与工程实践沉淀。</p>

        <div class="posts-list">
          {posts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .home-container {
    width: 880px;
    max-width: calc(100% - 2rem);
    margin: 1rem auto 3.5rem auto;
  }

  /* 个人简介区域 */
  .profile-section {
    padding: 0.5rem 0 2.25rem 0;
    border-bottom: 1px solid var(--card-border);
    margin-bottom: 2.75rem;
  }

  .profile-title {
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin: 0 0 0.85rem 0;
    color: var(--text);
  }

  .gradient-name {
    background: linear-gradient(135deg, var(--primary) 0%, #a855f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .wave-emoji {
    display: inline-block;
    transform-origin: 70% 70%;
    animation: wave 2.2s infinite ease-in-out;
  }

  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
  }

  .profile-bio {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 720px;
    margin: 0 0 1.5rem 0;
  }

  .profile-bio strong {
    color: var(--text);
    font-weight: 600;
  }

  .profile-bio-sub {
    font-size: 0.98rem;
    line-height: 1.65;
    margin-top: -0.65rem;
    margin-bottom: 1.5rem;
  }

  .profile-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.15rem;
    border-radius: 8px;
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background-color: var(--primary);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(79, 70, 229, 0.25);
  }

  .btn-primary:hover {
    background-color: var(--primary-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(79, 70, 229, 0.35);
  }

  .btn-secondary {
    background-color: var(--tag-bg);
    color: var(--text);
    border: 1px solid var(--card-border);
  }

  .btn-secondary:hover {
    border-color: var(--primary);
    color: var(--primary);
    transform: translateY(-1px);
  }

  .btn-github {
    background-color: var(--tag-bg);
    color: var(--text);
    border: 1px solid var(--card-border);
  }

  .btn-github:hover {
    border-color: var(--primary);
    color: var(--primary);
    transform: translateY(-1px);
  }

  /* 对半开内容展示区 */
  .showcase-sections {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .content-section {
    display: flex;
    flex-direction: column;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.35rem;
  }

  .section-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .section-indicator {
    width: 4px;
    height: 1.3rem;
    border-radius: 2px;
    background-color: var(--primary);
  }

  .section-indicator.post-indicator {
    background-color: #10b981;
  }

  .section-header h2 {
    font-size: 1.45rem;
    font-weight: 600;
    margin: 0;
  }

  .section-more {
    font-size: 0.88rem;
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    transition: transform 0.15s ease;
  }

  .section-more:hover {
    transform: translateX(2px);
    text-decoration: underline;
  }

  .section-desc {
    margin: 0 0 1.5rem 0;
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  /* 项目卡片列表 */
  .projects-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1.25rem;
  }

  /* 博客文章列表 */
  .posts-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 720px) {
    .home-container {
      margin: 1.25rem auto 2.5rem auto;
    }

    .hero-title {
      font-size: 1.8rem;
    }

    .hero-bio {
      font-size: 0.95rem;
    }

    .projects-list,
    .posts-list {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
