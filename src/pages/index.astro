---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BlogCard from "../components/BlogCard.astro";
import HeroBanner from "../components/HeroBanner.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<BaseLayout
  title="Farna - 个人主页与开源项目"
  description="Farna 的个人博客与开源软件主页，专注于 C++23、HuxerUI 原生桌面与跨平台开发"
>
  <div class="home-container">
    <!-- Hero Banner -->
    <HeroBanner />

    <!-- 核心板块：开源软件与博客经验 对半开展示 -->
    <div class="showcase-sections">
      <!-- 模块 1：开源项目 -->
      <section class="content-section">
        <div class="section-header">
          <div class="section-title-wrap">
            <span class="section-indicator"></span>
            <h2>开源项目</h2>
          </div>
          <a href="/projects" class="section-more">全部项目 &rarr;</a>
        </div>
        <p class="section-desc">专注于高性能、原生体验的桌面工具与代理生态实践。</p>

        <div class="projects-list">
          {projects.map((project) => (
            <ProjectCard project={project.data} />
          ))}
        </div>
      </section>

      <!-- 模块 2：最新博客与经验 -->
      <section class="content-section">
        <div class="section-header">
          <div class="section-title-wrap">
            <span class="section-indicator post-indicator"></span>
            <h2>经验记录</h2>
          </div>
          <a href="/blog" class="section-more">全部文章 &rarr;</a>
        </div>
        <p class="section-desc">日常技术探索、框架踩坑与工程实践沉淀。</p>

        <div class="posts-list">
          {posts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .home-container {
    width: 880px;
    max-width: calc(100% - 2rem);
    margin: 2rem auto 3.5rem auto;
  }

  /* 对半开内容展示区 */
  .showcase-sections {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .content-section {
    display: flex;
    flex-direction: column;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.35rem;
  }

  .section-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .section-indicator {
    width: 4px;
    height: 1.3rem;
    border-radius: 2px;
    background-color: var(--primary);
  }

  .section-indicator.post-indicator {
    background-color: #2da44e;
  }

  .section-header h2 {
    font-size: 1.45rem;
    font-weight: 600;
    margin: 0;
  }

  .section-more {
    font-size: 0.88rem;
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    transition: transform 0.15s ease;
  }

  .section-more:hover {
    transform: translateX(2px);
    text-decoration: underline;
  }

  .section-desc {
    margin: 0 0 1.5rem 0;
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  /* 项目卡片列表 */
  .projects-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1.25rem;
  }

  /* 博客文章列表 */
  .posts-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 720px) {
    .home-container {
      margin: 1.25rem auto 2.5rem auto;
    }

    .hero-title {
      font-size: 1.8rem;
    }

    .hero-bio {
      font-size: 0.95rem;
    }

    .projects-list,
    .posts-list {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
